# React Router fallback for Apache / LiteSpeed (Hostinger).
# Existing files and directories (images, CSS, JavaScript, etc.) remain served normally.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>
